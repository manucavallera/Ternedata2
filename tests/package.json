{
  "name": "ternedata-tests",
  "version": "1.0.0",
  "description": "Tests de integración contra producción",
  "scripts": {
    "test": "jest --runInBand --forceExit ternedata.test.js ternedata.second-batch.test.js",
    "test:local": "jest --runInBand --forceExit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "pg": "^8.20.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "verbose": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
